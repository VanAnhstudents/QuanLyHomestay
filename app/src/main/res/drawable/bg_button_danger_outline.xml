<?xml version="1.0" encoding="utf-8"?>
<!-- Button danger outline: nền trắng, viền đỏ, chữ đỏ -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái pressed: nền đỏ nhạt -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FEE2E2" />
            <stroke android:width="1.5dp" android:color="@color/status_error" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <!-- Trạng thái disabled -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F5F5F5" />
            <stroke android:width="1.5dp" android:color="#CCCCCC" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <!-- Trạng thái mặc định: nền trắng, viền đỏ -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_card" />
            <stroke android:width="1.5dp" android:color="@color/status_error" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
