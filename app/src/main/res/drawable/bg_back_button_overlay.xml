<?xml version="1.0" encoding="utf-8"?>
<!-- Nút back trên ảnh header: hình tròn trắng bán trong suốt, có viền xanh nhạt -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#CCE8EC" />
            <stroke android:width="1.5dp" android:color="@color/primary_main" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#CCFFFFFF" />
            <stroke android:width="1.5dp" android:color="#80C5DDE2" />
        </shape>
    </item>
</selector>
