<?xml version="1.0" encoding="utf-8"?>
<!--
    item_booking_compact.xml — Booking item compact (spec A6 mục 4, ux_ui.md)
    Height = height_listitem_title_only (56dp)
    Dùng trong RecyclerView "Đặt phòng hôm nay" và "Hoạt động gần đây"
    tại fragment_home.xml.

    Java (BookingCompactAdapter.java) bind:
        tv_booking_code  → DatPhong.getMaDatPhong() → "DP-001"
        tv_customer_name → KhachHang.getHoTen()
        tv_room_name     → Phong.getTenPhong()
        badge_status     → DatPhong.getTrangThai() → StatusBadgeView.setState()
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_listitem_title_only"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/margin_screen_horizontal"
    android:paddingEnd="@dimen/margin_screen_horizontal">

    <!-- Icon lịch bên trái -->
    <ImageView
        android:layout_width="@dimen/icon_size_listitem"
        android:layout_height="@dimen/icon_size_listitem"
        android:layout_marginEnd="10dp"
        android:contentDescription="Đặt phòng"
        android:src="@drawable/ic_calendar"
        android:tint="@color/primary_main" />

    <!-- Cột text giữa -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tên khách / phòng (16sp Medium) -->
        <TextView
            android:id="@+id/tv_compact_customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Nguyễn Văn A"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Tên phòng (12sp gray) -->
        <TextView
            android:id="@+id/tv_compact_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Phòng 101"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Badge trạng thái bên phải -->
    <TextView
        android:id="@+id/badge_compact_status"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/badge_height"
        android:background="@drawable/bg_badge_pill"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Sắp đến"
        android:textColor="@color/badge_dadat_text"
        android:textSize="11sp" />

</LinearLayout>