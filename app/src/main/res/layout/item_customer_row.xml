<?xml version="1.0" encoding="utf-8"?>
<!--
    item_customer_row.xml — Item cho RecyclerView ở CustomerListFragment (D1)
    Theo ux_ui.md mục D1 / item_customer_row.xml (72dp):
        a) Avatar tròn 48dp (initials nếu không có ảnh)
        b) Cột phải: Tên (16sp SemiBold) + SĐT (13sp gray) + Email (12sp gray)
        c) Icon ">" (16dp, icon_inactive)
    Root: RelativeLayout, height = height_listitem_with_subtitle (72dp)
    Chỉ dùng LinearLayout / RelativeLayout / FrameLayout theo quy tắc layout bắt buộc.
-->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_customer_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_listitem_with_subtitle"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- a) Avatar tròn 48dp — hiển thị initials khi KhachHang.getAvatar() null/rỗng -->
    <TextView
        android:id="@+id/tv_avatar_initials"
        android:layout_width="@dimen/avatar_listitem_size"
        android:layout_height="@dimen/avatar_listitem_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_screen_horizontal"
        android:background="@drawable/bg_avatar_circle"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:text="A"
        android:textColor="@color/text_on_primary"
        android:textSize="18sp" />

    <!-- c) Icon ">" — căn phải, giữa dòng -->
    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/margin_screen_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_inactive" />

    <!-- b) Cột phải: Tên + SĐT + Email -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="40dp"
        android:layout_toEndOf="@id/tv_avatar_initials"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ho_ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Nguyen Thi Mai"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_sdt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0912345601"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="mai.nguyen@gmail.com"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Divider 1dp dưới cùng item -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_divider"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/margin_screen_horizontal"
        android:background="@color/divider" />

</RelativeLayout>