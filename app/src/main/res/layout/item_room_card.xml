<?xml version="1.0" encoding="utf-8"?>
<!-- item_room_card.xml – Item card cho RecyclerView danh sách phòng (B1) -->
<!-- Cao 90dp, layout theo spec ux_ui.md B1 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:background="@color/background_card"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Hình ảnh phòng: 80x80dp, căn trái, bo tròn -->
    <ImageView
        android:id="@+id/iv_room_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_card_listitem"
        android:contentDescription="Hình phòng"
        android:scaleType="centerCrop" />

    <!-- Badge trạng thái: góc trên phải -->
    <TextView
        android:id="@+id/tv_room_status"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_margin="8dp"
        android:background="@drawable/bg_badge_trong"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="Trống"
        android:textSize="11sp" />

    <!-- Cột thông tin chữ: nằm bên phải ảnh, giữa theo chiều dọc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/iv_room_image"
        android:layout_toStartOf="@id/tv_room_status"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="P101"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_room_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Standard"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_room_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="550,000 đ/đêm"
            android:textColor="@color/primary_main"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider dưới cùng -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/divider" />

</RelativeLayout>
