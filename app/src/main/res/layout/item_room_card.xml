<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:background="@color/background_card"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Hình ảnh phòng -->
    <ImageView
        android:id="@+id/iv_room_image"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_card_listitem"
        android:contentDescription="Hình phòng"
        android:scaleType="centerCrop" />

    <!-- Icon > -->
    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/icon_inactive" />

    <!-- Badge trạng thái -->
    <TextView
        android:id="@+id/tv_room_status"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_toStartOf="@id/iv_chevron"
        android:layout_alignTop="@id/iv_chevron"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_badge_trong"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:text="Trống"
        android:textSize="11sp" />

    <!-- Thông tin phòng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/iv_room_image"
        android:layout_toStartOf="@id/tv_room_status"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="P101"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_room_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Standard"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_room_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="550,000 đ/đêm"
            android:textColor="@color/primary_main"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_alignParentBottom="true"
        android:background="@color/divider" />

</RelativeLayout>