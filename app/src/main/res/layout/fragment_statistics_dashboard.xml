<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_statistics_dashboard.xml – H1: Dashboard Thống kê
    Cấu trúc: Row chọn kỳ (cố định trên cùng) → ScrollView (KPI cards linh hoạt + biểu đồ)
    KPI section dùng GridLayout 2 cột, tự co giãn theo nội dung, không hardcode số lượng card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <include
        android:id="@+id/breadcrumb"
        layout="@layout/layout_breadcrumb" />

    <!-- ══════════════════════════════════════════════════════
         Row chọn kỳ — CỐ ĐỊNH trên cùng, không cuộn
         ══════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary_light"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/chip_today"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hôm nay"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_week"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tuần"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_month"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tháng"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_quarter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Quý"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_year"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Năm"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ══════════════════════════════════════════════════════
         ScrollView bao phủ toàn bộ phần còn lại:
         KPI cards (linh hoạt) + biểu đồ + top phòng
         ══════════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ────────────────────────────────────────────────
                 KPI Cards — GridLayout 2 cột, linh hoạt
                 Thêm/bớt card chỉ cần thêm/bớt View con,
                 không cần cứng số hàng.
                 ──────────────────────────────────────────────── -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/grid_kpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                app:columnCount="2"
                app:useDefaultMargins="false">

                <!-- KPI 1: Doanh thu -->
                <LinearLayout
                    android:id="@+id/card_revenue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white"
                    android:padding="10dp"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    app:layout_columnSpan="1"
                    app:layout_gravity="fill_horizontal"
                    android:layout_margin="4dp">

                    <TextView
                        android:id="@+id/tv_revenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/primary_main"
                        android:text="0 đ"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:text="Doanh thu"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- KPI 2: Số lượt khách -->
                <LinearLayout
                    android:id="@+id/card_guests"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white"
                    android:padding="10dp"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    app:layout_columnSpan="1"
                    app:layout_gravity="fill_horizontal"
                    android:layout_margin="4dp">

                    <TextView
                        android:id="@+id/tv_guests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/status_success"
                        android:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:text="Số lượt khách"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- KPI 3: Công suất phòng -->
                <LinearLayout
                    android:id="@+id/card_occupancy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white"
                    android:padding="10dp"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    app:layout_columnSpan="1"
                    app:layout_gravity="fill_horizontal"
                    android:layout_margin="4dp">

                    <TextView
                        android:id="@+id/tv_occupancy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="@color/status_warning"
                        android:text="0%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:text="Công suất phòng"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- KPI 4: Số đặt phòng -->
                <LinearLayout
                    android:id="@+id/card_bookings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_white"
                    android:padding="10dp"
                    app:layout_columnWeight="1"
                    app:layout_rowWeight="1"
                    app:layout_columnSpan="1"
                    app:layout_gravity="fill_horizontal"
                    android:layout_margin="4dp">

                    <TextView
                        android:id="@+id/tv_bookings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#9B7FE8"
                        android:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:text="Số đặt phòng"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- ── Hướng mở rộng: muốn thêm KPI thứ 5, 6, ... ──
                     Chỉ cần thêm <LinearLayout> tương tự ở đây,
                     GridLayout 2 cột sẽ tự xuống hàng. ── -->

            </androidx.gridlayout.widget.GridLayout>

            <!-- ────────────────────────────────────────────────
                 Card biểu đồ Doanh thu (BarChart)
                 ──────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp">

                <!-- Hàng tiêu đề + nút Xem chi tiết -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📊 Doanh thu"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_revenue_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem chi tiết →"
                        android:textSize="13sp"
                        android:textColor="@color/primary_main"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Placeholder cho BarChart (thêm programmatically) -->
                <FrameLayout
                    android:id="@+id/chart_container_bar"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

                <!-- Fallback TextView nếu không có dữ liệu -->
                <TextView
                    android:id="@+id/tv_chart_bar_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Không có dữ liệu doanh thu trong kỳ này"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="32dp" />
            </LinearLayout>

            <!-- ────────────────────────────────────────────────
                 Card biểu đồ Công suất phòng (PieChart)
                 ──────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp">

                <!-- Hàng tiêu đề + nút mũi tên -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🏠 Công suất các phòng"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_occupancy_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem chi tiết →"
                        android:textSize="13sp"
                        android:textColor="@color/primary_main"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/chart_container_pie"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_legend_trong"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/status_success"
                        android:text="⬤ Phòng trống: 0"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tv_legend_dangthue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/status_warning"
                        android:text="⬤ Đang thuê: 0"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tv_legend_dadat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/status_error"
                        android:text="⬤ Đã đặt: 0" />
                </LinearLayout>
            </LinearLayout>

            <!-- ────────────────────────────────────────────────
                 Card Top 5 phòng doanh thu cao
                 ──────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏆 Top 5 phòng doanh thu cao"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Container top phòng (thêm dynamically) -->
                <LinearLayout
                    android:id="@+id/ll_top_rooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
