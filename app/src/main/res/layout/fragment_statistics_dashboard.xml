<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_statistics_dashboard.xml – H1: Dashboard Thống kê
    Cấu trúc: AppBar → Row chọn kỳ → 4 KPI card → ScrollView biểu đồ
    Lưu ý: MPAndroidChart BarChart / PieChart được thêm dynamically hoặc qua thư viện
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <!-- Row chọn kỳ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/primary_light"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/chip_today"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Hôm nay"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_primary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_week"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tuần"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_month"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Tháng"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_quarter"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Quý"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:layout_marginEnd="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_year"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Năm"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Grid 4 KPI card (2 hàng × 2 cột) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp">

        <!-- Hàng 1: Doanh thu + Số lượt khách -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_revenue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_white"
                android:layout_margin="4dp"
                android:padding="8dp">
                <TextView android:id="@+id/tv_revenue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="16sp" android:fontFamily="sans-serif-bold"
                    android:textColor="@color/primary_main" android:text="0 đ" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/text_secondary"
                    android:text="Doanh thu" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_guests"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_white"
                android:layout_margin="4dp"
                android:padding="8dp">
                <TextView android:id="@+id/tv_guests"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="22sp" android:fontFamily="sans-serif-bold"
                    android:textColor="@color/status_success" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/text_secondary"
                    android:text="Số lượt khách" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hàng 2: Công suất + Số đặt phòng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_occupancy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_white"
                android:layout_margin="4dp"
                android:padding="8dp">
                <TextView android:id="@+id/tv_occupancy"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="22sp" android:fontFamily="sans-serif-bold"
                    android:textColor="@color/status_warning" android:text="0%" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/text_secondary"
                    android:text="Công suất phòng" android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_bookings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card_white"
                android:layout_margin="4dp"
                android:padding="8dp">
                <TextView android:id="@+id/tv_bookings"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="22sp" android:fontFamily="sans-serif-bold"
                    android:textColor="#9B7FE8" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:textColor="@color/text_secondary"
                    android:text="Số đặt phòng" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ScrollView biểu đồ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Card biểu đồ Doanh thu (BarChart) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Doanh thu theo ngày"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Placeholder cho BarChart (thêm programmatically) -->
                <FrameLayout
                    android:id="@+id/chart_container_bar"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />

                <!-- Fallback TextView nếu không có dữ liệu -->
                <TextView
                    android:id="@+id/tv_chart_bar_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Không có dữ liệu doanh thu trong kỳ này"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:visibility="gone"
                    android:padding="32dp" />
            </LinearLayout>

            <!-- Card biểu đồ Công suất phòng (PieChart) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏠 Tỷ lệ trạng thái phòng"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:id="@+id/chart_container_pie"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />

                <!-- Legend -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <TextView android:id="@+id/tv_legend_trong"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:textColor="@color/status_success"
                        android:text="⬤ Trống: 0" android:layout_marginEnd="16dp" />

                    <TextView android:id="@+id/tv_legend_dangthue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:textColor="@color/status_warning"
                        android:text="⬤ Đang thuê: 0" android:layout_marginEnd="16dp" />

                    <TextView android:id="@+id/tv_legend_dadat"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:textColor="@color/status_error"
                        android:text="⬤ Đã đặt: 0" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card Top 5 phòng doanh thu cao -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏆 Top 5 phòng doanh thu cao"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Container top phòng (thêm dynamically) -->
                <LinearLayout
                    android:id="@+id/ll_top_rooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
