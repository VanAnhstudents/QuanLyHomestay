<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_invoice_create.xml – G3: Lập hóa đơn mới
    Root: LinearLayout (vertical) → ScrollView + nút cố định dưới
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <include
        android:id="@+id/breadcrumb"
        layout="@layout/layout_breadcrumb" />

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Header tiêu đề trang -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lập hóa đơn mới"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- AutoComplete chọn đặt phòng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chọn đặt phòng:"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_normal">

                    <AutoCompleteTextView
                        android:id="@+id/ac_dat_phong"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Tìm theo mã đặt phòng / tên khách..."
                        android:textColorHint="@color/text_placeholder"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:completionThreshold="1"
                        android:dropDownHeight="200dp"
                        android:inputType="text" />
                </FrameLayout>
            </LinearLayout>

            <!-- Card tự điền thông tin -->
            <LinearLayout
                android:id="@+id/card_auto_fill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_form"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:text="Thông tin đặt phòng"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:text="Phòng:" />
                    <TextView android:id="@+id/tv_af_phong" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textColor="@color/text_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:text="Khách hàng:" />
                    <TextView android:id="@+id/tv_af_khach" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textColor="@color/text_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:text="Check-in:" />
                    <TextView android:id="@+id/tv_af_checkin" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textColor="@color/text_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:text="Check-out:" />
                    <TextView android:id="@+id/tv_af_checkout" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textColor="@color/text_primary" android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:text="Tiền phòng:" />
                    <TextView android:id="@+id/tv_af_tien_phong" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/primary_main"
                        android:text="0 đ" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card chi tiết phí -->
            <LinearLayout
                android:id="@+id/card_fees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:text="Phụ thu dịch vụ"
                    android:layout_marginBottom="10dp" />

                <!-- Container phụ thu động -->
                <LinearLayout
                    android:id="@+id/ll_fees_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Nút +Thêm dòng phí -->
                <LinearLayout
                    android:id="@+id/btn_add_fee_row"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_button_outline"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Thêm dòng phí"
                        android:textSize="13sp"
                        android:textColor="@color/primary_main" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <!-- Tổng realtime -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="15sp"
                        android:fontFamily="sans-serif-bold" android:textColor="@color/text_primary"
                        android:text="TỔNG CỘNG:" />
                    <TextView android:id="@+id/tv_tong_cong" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="18sp"
                        android:fontFamily="sans-serif-bold" android:textColor="@color/primary_main"
                        android:text="0 đ" />
                </LinearLayout>
            </LinearLayout>

            <!-- Phương thức thanh toán -->
            <LinearLayout
                android:id="@+id/ll_phuong_thuc_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phương thức thanh toán:"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_normal">

                    <Spinner
                        android:id="@+id/spinner_phuong_thuc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@null" />
                </FrameLayout>
            </LinearLayout>

            <!-- Ghi chú -->
            <LinearLayout
                android:id="@+id/ll_ghi_chu_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú:"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_input_normal">

                    <EditText
                        android:id="@+id/et_ghi_chu"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Nhập ghi chú (nếu có)..."
                        android:textColorHint="@color/text_placeholder"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@null"
                        android:padding="12dp"
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:minLines="3" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Nút "Tạo hóa đơn" cố định dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_card"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/btn_create_invoice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tạo hóa đơn"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_primary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>