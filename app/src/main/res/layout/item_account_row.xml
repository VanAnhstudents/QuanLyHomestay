<?xml version="1.0" encoding="utf-8"?>
<!-- item_account_row.xml — 72dp, consistent with item_customer_row.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_listitem_with_subtitle"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar initials 48dp -->
    <TextView
        android:id="@+id/tv_initials"
        android:layout_width="@dimen/avatar_listitem_size"
        android:layout_height="@dimen/avatar_listitem_size"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/margin_screen_horizontal"
        android:background="@drawable/bg_avatar_circle"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:textColor="@color/text_on_primary"
        android:textSize="18sp" />

    <!-- Icon ba chấm (căn phải) -->
    <ImageButton
        android:id="@+id/btn_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_more_vert"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Thêm tùy chọn"
        app:tint="@color/icon_action" />

    <!-- Badge vai trò (trước icon ba chấm) -->
    <TextView
        android:id="@+id/tv_badge_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/btn_more"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:fontFamily="sans-serif"
        android:textSize="11sp"
        android:background="@drawable/bg_chip_filter_active" />

    <!-- Tên + Email -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/tv_initials"
        android:layout_toStartOf="@id/tv_badge_role"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_ten_tai_khoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Divider 1dp bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_divider"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/margin_screen_horizontal"
        android:background="@color/divider" />

</RelativeLayout>
