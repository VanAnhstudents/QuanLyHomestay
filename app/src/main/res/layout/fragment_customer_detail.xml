<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_customer_detail.xml — Chi tiết khách hàng (D2)
    Root: ScrollView > LinearLayout (vertical)
    Chỉ dùng LinearLayout / RelativeLayout / FrameLayout — KHÔNG dùng ConstraintLayout.
    Phân quyền: Row nút Sửa/Xóa (id=row_action_buttons) ẩn/hiện runtime trong Java.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Breadcrumb -->
        <include
            android:id="@+id/breadcrumb"
            layout="@layout/layout_breadcrumb" />

        <!-- ===== (1) Header: Avatar + Tên + Badge số lần thuê ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"
            android:background="@color/background_screen">

            <!-- Avatar tròn 80dp -->
            <FrameLayout
                android:layout_width="@dimen/avatar_detail_large"
                android:layout_height="@dimen/avatar_detail_large">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_avatar_detail"
                    android:layout_width="@dimen/avatar_detail_large"
                    android:layout_height="@dimen/avatar_detail_large"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.LalaHouse.Circle" />

                <TextView
                    android:id="@+id/tv_initials_detail"
                    android:layout_width="@dimen/avatar_detail_large"
                    android:layout_height="@dimen/avatar_detail_large"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/text_on_primary"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </FrameLayout>

            <!-- Tên khách hàng -->
            <TextView
                android:id="@+id/tv_ten_khach_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="20sp"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Badge: số lần đã thuê -->
            <TextView
                android:id="@+id/tv_badge_so_lan_thue"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/badge_height"
                android:layout_marginTop="8dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_badge_dathanhtoan"
                android:textColor="@color/badge_dathanhtoan_text" />

        </LinearLayout>

        <!-- ===== (2) Card thông tin cá nhân ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_screen_horizontal"
            android:layout_marginEnd="@dimen/margin_screen_horizontal"
            android:layout_marginTop="@dimen/spacing_xs"
            app:cardCornerRadius="@dimen/radius_card_large"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/background_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card_default">

                <!-- Tiêu đề card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin cá nhân"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-bold"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="@dimen/spacing_sm" />

                <!-- Row: Số điện thoại -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Điện thoại"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_sdt_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_primary"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_divider"
                    android:background="@color/divider" />

                <!-- Row: Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_email_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_divider"
                    android:background="@color/divider" />

                <!-- Row: CCCD/CMND -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="CCCD/CMND"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_cccd_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_primary"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_divider"
                    android:background="@color/divider" />

                <!-- Row: Địa chỉ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Địa chỉ"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_dia_chi_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_primary"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_divider"
                    android:background="@color/divider" />

                <!-- Row: Ngày sinh + Giới tính -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Ngày sinh"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_ngay_sinh_detail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_primary"
                        android:gravity="end" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== (3) Card lịch sử đặt phòng ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_screen_horizontal"
            android:layout_marginEnd="@dimen/margin_screen_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_card_large"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/background_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card_default">

                <!-- Header "Lịch sử lưu trú" + "Xem tất cả" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lịch sử lưu trú"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-bold"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_xem_tat_ca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/text_link"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- RecyclerView 3 lần đặt phòng gần nhất -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_lich_su_dat_phong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty: không có lịch sử -->
                <TextView
                    android:id="@+id/tv_no_history"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="Chưa có lịch sử lưu trú"
                    android:textSize="13sp"
                    android:textColor="@color/icon_inactive"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== (4) Row 2 nút Chỉnh sửa / Xóa (ẩn runtime nếu ChiXem) ===== -->
        <LinearLayout
            android:id="@+id/row_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/margin_screen_horizontal"
            android:layout_marginEnd="@dimen/margin_screen_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical">

            <!-- Nút Chỉnh sửa (outline) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_chinh_sua"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Chỉnh sửa"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/primary_main"
                app:backgroundTint="@color/background_card"
                app:strokeColor="@color/primary_main"
                app:strokeWidth="1.5dp"
                app:cornerRadius="@dimen/radius_button" />

            <!-- Nút Xóa (outline đỏ) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_xoa"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="Xóa"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/status_error"
                app:backgroundTint="@color/background_card"
                app:strokeColor="@color/status_error"
                app:strokeWidth="1.5dp"
                app:cornerRadius="@dimen/radius_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>