<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_room_list.xml – Danh sách phòng (B1) -->
<!-- Root: LinearLayout vertical, chỉ dùng LinearLayout/RelativeLayout/FrameLayout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:orientation="vertical">

    <!-- Breadcrumb -->
    <include layout="@layout/layout_breadcrumb"
        android:id="@+id/breadcrumb"
        android:layout_width="match_parent"
        android:layout_height="36dp" />

    <!-- Row công cụ: SearchBar (nút Thêm đã chuyển sang FAB) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- SearchBar full width -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Tìm kiếm"
                android:src="@drawable/ic_search"
                app:tint="@color/icon_inactive" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Tìm phòng..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter chips: Tất cả / Trống / Đang thuê / Đã đặt -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_filter_active"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Tất cả"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_trong"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Trống"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_dang_thue"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Đang thuê"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_da_dat"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_filter_inactive"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Đã đặt"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- RelativeLayout bọc RecyclerView + FAB -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView danh sách phòng -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_room_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_alignParentTop="true"
            android:clipToPadding="false"
            android:paddingBottom="80dp" />

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/layout_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Trống"
                android:src="@drawable/ic_bed"
                app:tint="#C5DDE2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Không có phòng nào"
                android:textColor="@color/icon_inactive"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- FAB Thêm phòng (ẩn nếu không phải Admin) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_room"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            android:backgroundTint="@color/primary_main"
            android:contentDescription="Thêm phòng"
            android:src="@drawable/ic_add"
            android:visibility="gone" />
    </RelativeLayout>

</LinearLayout>


