<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_invoice_list.xml – G1: Danh sách hóa đơn
    Cấu trúc: AppBar → Row tóm tắt → SearchBar → Filter chips → RecyclerView
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <!-- App Bar -->
    <include layout="@layout/layout_appbar" />

    <!-- Breadcrumb -->
    <include
        android:id="@+id/breadcrumb"
        layout="@layout/layout_breadcrumb" />

    <!-- Row tóm tắt nhanh -->
    <LinearLayout
        android:id="@+id/ll_summary"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/primary_light"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_today_revenue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:text="Tổng hôm nay: 0 đ" />

        <TextView
            android:id="@+id/tv_invoice_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:text="Số HĐ: 0" />
    </LinearLayout>

    <!-- SearchBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/icon_inactive" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Tìm theo tên khách, mã HĐ..."
                    android:textColorHint="@color/text_placeholder"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:background="@null"
                    android:paddingStart="8dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Tất cả"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_chip_filter_active"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_paid"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Đã thanh toán"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_filter_inactive"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_unpaid"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Chưa thanh toán"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_filter_inactive"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_refund"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Hoàn tiền"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:background="@drawable/bg_chip_filter_inactive"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- RecyclerView + EmptyState -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_invoices"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="8dp"
            android:clipToPadding="false" />

        <include
            android:id="@+id/empty_state"
            layout="@layout/component_empty_state"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
