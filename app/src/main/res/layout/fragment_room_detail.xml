<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_room_detail.xml – Chi tiết phòng (B2) -->
<!-- Root: ScrollView – không có appbar inline, không cố định button -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <include android:id="@+id/breadcrumb" layout="@layout/layout_breadcrumb" />

    <!-- Header ảnh phòng: 220dp -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

                <ImageView
                    android:id="@+id/iv_room_header"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:contentDescription="Ảnh phòng"
                    android:scaleType="centerCrop" />

                <!-- Overlay gradient mờ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/bg_gradient_overlay" />

                <!-- Back button hình tròn -->
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_back_button_overlay"
                    android:contentDescription="Quay lại"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/primary_main" />

                <!-- Badge trạng thái -->
                <TextView
                    android:id="@+id/tv_room_status_header"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_badge_trong"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Trống"
                    android:textSize="12sp" />
            </RelativeLayout>

            <!-- Card thông tin chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Tên phòng + loại -->
                <TextView
                    android:id="@+id/tv_room_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P101"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_room_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Standard"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Giá -->
                <TextView
                    android:id="@+id/tv_room_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="550,000 đ/đêm"
                    android:textColor="@color/primary_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider" />

                <!-- Grid thông tin: Sức chứa / Diện tích / Tầng (3 cột) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Sức chứa -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Sức chứa"
                            android:src="@drawable/ic_person"
                            android:tint="@color/primary_main" />

                        <TextView
                            android:id="@+id/tv_suc_chua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2 người"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sức chứa"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Diện tích -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Diện tích"
                            android:src="@drawable/ic_bed"
                            android:tint="@color/primary_main" />

                        <TextView
                            android:id="@+id/tv_dien_tich"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="22 m²"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diện tích"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Tầng -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Tầng"
                            android:src="@drawable/ic_home"
                            android:tint="@color/primary_main" />

                        <TextView
                            android:id="@+id/tv_tang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tầng 1"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vị trí"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider" />

                <!-- Section Tiện nghi -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiện nghi"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ll_tien_nghi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider" />

                <!-- Section Mô tả -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mô tả"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mo_ta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.5"
                    android:text="Mô tả phòng..."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Bottom padding -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>

        <!-- ===== Row hành động: Chỉnh sửa / Xóa / Đặt phòng ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Hàng 1: Chỉnh sửa + Xóa phòng -->
            <LinearLayout
                android:id="@+id/row_edit_delete"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_room"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Chỉnh sửa"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/primary_main"
                    app:backgroundTint="@color/background_card"
                    app:strokeColor="@color/primary_main"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="@dimen/radius_button"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_room"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Xóa phòng"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/status_error"
                    app:backgroundTint="@color/background_card"
                    app:strokeColor="@color/status_error"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="@dimen/radius_button"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Hàng 2: Đặt phòng -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_book_room"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_main"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="ĐẶT PHÒNG"
                android:textSize="16sp"
                android:fontFamily="sans-serif-bold"
                android:textStyle="bold"
                android:textColor="@color/text_on_primary"
                app:backgroundTint="@color/primary_main"
                app:cornerRadius="@dimen/radius_button" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
