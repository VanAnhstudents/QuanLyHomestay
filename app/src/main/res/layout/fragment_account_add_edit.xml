<?xml version="1.0" encoding="utf-8"?>
<!-- E3. Thêm / Sửa tài khoản — consistent with fragment_customer_add_edit.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <include android:id="@+id/breadcrumb" layout="@layout/layout_breadcrumb" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_screen_horizontal"
            android:layout_marginEnd="@dimen/margin_screen_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/radius_card_large"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/background_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_card_default">

                <!-- Tên đăng nhập -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tên đăng nhập *" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_username"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_input" app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input" app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxStrokeColor="@color/border_input"
                    android:hint="Nhập tên đăng nhập"
                    app:errorEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_username" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_input" app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input" app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxStrokeColor="@color/border_input"
                    android:hint="Nhập địa chỉ email">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Mật khẩu (chỉ thêm mới — ẩn khi sửa qua Java) -->
                <TextView android:id="@+id/label_password" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mật khẩu *" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_password"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_input" app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input" app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxStrokeColor="@color/border_input"
                    android:hint="Nhập mật khẩu"
                    app:errorEnabled="true"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Xác nhận mật khẩu -->
                <TextView android:id="@+id/label_confirm_password" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Xác nhận mật khẩu *" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_confirm_password"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_input" app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input" app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxStrokeColor="@color/border_input"
                    android:hint="Nhập lại mật khẩu"
                    app:errorEnabled="true"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/et_confirm_password" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Vai trò -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vai trò" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:layout_marginBottom="4dp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_vai_tro"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:boxCornerRadiusTopStart="@dimen/radius_input" app:boxCornerRadiusTopEnd="@dimen/radius_input"
                    app:boxCornerRadiusBottomStart="@dimen/radius_input" app:boxCornerRadiusBottomEnd="@dimen/radius_input"
                    app:boxStrokeColor="@color/border_input"
                    android:hint="Chọn vai trò">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/dropdown_vai_tro" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:inputType="none" android:focusable="false" android:focusableInTouchMode="false" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Trạng thái -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trạng thái hoạt động" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switch_trang_thai" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_luu"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_main"
            android:layout_marginStart="@dimen/margin_screen_horizontal"
            android:layout_marginEnd="@dimen/margin_screen_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Lưu"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            app:backgroundTint="@color/primary_main"
            app:cornerRadius="@dimen/radius_button" />

    </LinearLayout>
</ScrollView>
