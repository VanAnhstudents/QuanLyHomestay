<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_room_add_edit.xml – Thêm/Sửa phòng (B3) -->
<!-- Root: ScrollView bọc toàn bộ, không có AppBar inline (dùng AppBar chung của activity_main) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Ảnh phòng: clickable, 180dp, bo tròn -->
        <FrameLayout
            android:id="@+id/fl_pick_image"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card_listitem"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_room_image_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ảnh phòng"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Thêm ảnh"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/icon_inactive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Thêm ảnh phòng"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Nút X xóa ảnh (chỉ hiện khi đã có ảnh) -->
            <TextView
                android:id="@+id/btn_clear_image"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_badge_dadat"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Card form thông tin phòng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tên phòng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên phòng *"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_ten_phong"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:hint="Ví dụ: P101"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

            <!-- Loại phòng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loại phòng *"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_loai_phong"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:paddingHorizontal="12dp" />

            <!-- Giá/đêm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Giá/đêm (VNĐ) *"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_gia_moi_dem"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:hint="0"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

            <!-- Sức chứa -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sức chứa (người)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_suc_chua"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:hint="2"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

            <!-- Diện tích -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Diện tích (m²)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_dien_tich"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:hint="22"
                android:inputType="numberDecimal"
                android:paddingHorizontal="12dp"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

            <!-- Tầng -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tầng"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_tang"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:hint="1"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />

            <!-- Trạng thái -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Trạng thái"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_trang_thai"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:paddingHorizontal="12dp" />

            <!-- Tiện nghi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tiện nghi"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Container tiện nghi checkboxes (2 cột, tạo động trong Java) -->
            <LinearLayout
                android:id="@+id/ll_tien_nghi_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- Mô tả -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mô tả"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_mo_ta"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_normal"
                android:gravity="top"
                android:hint="Nhập mô tả phòng..."
                android:inputType="textMultiLine"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColorHint="@color/text_placeholder"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Row nút Hủy + Lưu – nằm trong scroll, không cố định -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Button Hủy: nền trắng, viền xanh, chữ xanh -->
            <Button
                android:id="@+id/btn_cancel_room"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline"
                android:text="Hủy"
                android:textColor="@color/primary_main"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Button Lưu -->
            <Button
                android:id="@+id/btn_save_room"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="Lưu phòng"
                android:textColor="@color/text_on_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
