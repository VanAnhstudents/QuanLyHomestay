<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_occupancy_report.xml – H3: Báo cáo Công suất phòng
    Cấu trúc: AppBar → DateRange picker + Button Xem → ScrollView (4 chỉ số + LineChart + bảng chi tiết)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_screen">

    <!-- DateRange Picker + Button Xem -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_card"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Báo cáo công suất phòng"
            android:textSize="16sp"
            android:fontFamily="sans-serif-bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Từ ngày -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Từ ngày:"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_normal"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <ImageView
                            android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_calendar" android:tint="@color/primary_main"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:id="@+id/tv_from_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:text="Chọn ngày" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="16dp" android:layout_height="wrap_content"
                android:gravity="center" android:text="→"
                android:textColor="@color/text_secondary" android:layout_marginTop="16dp" />

            <!-- Đến ngày -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đến ngày:"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="4dp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_normal"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <ImageView
                            android:layout_width="16dp" android:layout_height="16dp"
                            android:src="@drawable/ic_calendar" android:tint="@color/primary_main"
                            android:layout_marginEnd="6dp" />
                        <TextView
                            android:id="@+id/tv_to_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:text="Chọn ngày" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_view_report"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem báo cáo"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/text_on_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ScrollView nội dung -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Card 4 chỉ số -->
            <LinearLayout
                android:id="@+id/card_metrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_form"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tổng quan công suất"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Hàng 1: Tổng phòng + Đêm khả dụng -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_white"
                        android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tv_total_rooms"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"
                            android:textColor="@color/primary_main" android:text="0" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_secondary"
                            android:text="Tổng phòng" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_white"
                        android:layout_marginStart="6dp">
                        <TextView android:id="@+id/tv_available_nights"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"
                            android:textColor="@color/text_primary" android:text="0" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_secondary"
                            android:text="Đêm khả dụng" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Hàng 2: Đêm đã bán + Công suất % -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_white"
                        android:layout_marginEnd="6dp">
                        <TextView android:id="@+id/tv_sold_nights"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="20sp" android:fontFamily="sans-serif-bold"
                            android:textColor="@color/status_success" android:text="0" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_secondary"
                            android:text="Đêm đã bán" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_white"
                        android:layout_marginStart="6dp">
                        <TextView android:id="@+id/tv_occupancy_rate"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="22sp" android:fontFamily="sans-serif-bold"
                            android:textColor="@color/status_warning" android:text="0%" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="10sp" android:textColor="@color/text_secondary"
                            android:text="Công suất %" android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card LineChart công suất theo ngày -->
            <LinearLayout
                android:id="@+id/card_line_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📈 Công suất theo ngày (%)"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <FrameLayout
                    android:id="@+id/chart_line_container"
                    android:layout_width="match_parent"
                    android:layout_height="220dp" />
            </LinearLayout>

            <!-- Card bảng chi tiết từng phòng -->
            <LinearLayout
                android:id="@+id/card_room_table"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_white"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 Chi tiết theo từng phòng"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Header row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/primary_light"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="2" android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"
                        android:text="Tên phòng" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"
                        android:text="Đêm" android:gravity="center" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="2" android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"
                        android:text="Doanh thu" android:gravity="end" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary"
                        android:text="CS%" android:gravity="end" />
                </LinearLayout>

                <!-- Data rows (thêm dynamically) -->
                <LinearLayout
                    android:id="@+id/ll_room_table_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn khoảng ngày và nhấn 'Xem báo cáo'"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="visible" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
